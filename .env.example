# Copy to .env. Everything is optional, but set SITE_DOMAIN once the site
# is online. The database and session secret are created automatically in
# the "dbdata" volume. After changing this file, restart with
# ./deploy.sh --force (or docker compose up -d --force-recreate).

# --- Site ---
# Display name for the site, shown in the header/title and RSS feed.
# Can also be changed later in the admin UI (site settings) — this is just the initial value.
SITE_NAME=Fedigest

# The public domain this instance is served from (e.g. news.example.com),
# always over HTTPS. Used for absolute links in RSS feeds, sitemap.xml and
# link previews, in password-reset emails, and in the User-Agent sent to
# other instances. Without it, links are built from each request.
SITE_DOMAIN=

# Username for the first-run admin account (default "admin"). Only used on
# first boot; the password is generated and printed to the logs once.
ADMIN_USERNAME=

# Where visitors can get this site's source code, linked as "Source" in the
# footer. Fedigest is AGPL-3.0 licensed: if you run a modified version, point
# this at your own copy of the code. Empty means the official repository.
SOURCE_URL=

# --- Behavior ---
# How long (in seconds, at least 1) a fetched comment thread is used before
# a post-page view fetches it again; also how long a post whose original
# couldn't be reached waits before it's tried again. Doesn't affect the
# separate background comment-count refresh for frontpage cards.
COMMENT_CACHE_TTL=60

# Address + port the app listens on inside the container.
# Usually left as-is — Docker Compose maps this to a host port separately.
LISTEN_ADDR=:8080

# Directory (inside the container) where uploaded images/avatars/site icon are stored.
# Backed by its own Docker volume ("uploads") so files survive container restarts.
UPLOADS_DIR=/app/uploads

# --- Email (optional — only needed for password-reset emails) ---
# If SMTP_HOST is blank, "forgot password" is disabled and admins reset
# passwords manually. Reset emails also need SITE_DOMAIN above, which the
# links are built from.
SMTP_HOST=
# 587 (the default) upgrades to TLS with STARTTLS; 465 uses TLS from the
# start. A login is only ever sent over TLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender, e.g. "Fedigest <noreply@news.example.com>"; defaults to SMTP_USER.
SMTP_FROM=
